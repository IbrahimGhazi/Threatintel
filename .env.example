# ════════════════════════════════════════════════════════════════
#  Threat Intelligence Platform — Environment Configuration
# ════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in real values BEFORE deploying.
#  See docs/SETUP.md for what each variable controls and which ones
#  must be set as Docker --build-arg vs. runtime env vs. k8s Secret.
#  NEVER commit a populated .env — it is in .gitignore for a reason.
# ════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# 64-char random hex; used for signing internal tokens.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-string

# 16+ char random; used by every service to authenticate to the API.
# This is the ONLY API key the frontend sends as X-API-Key.
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
API_KEY=change-me-to-a-secure-api-key

# Fernet master key for encrypting the BYO threat-feed credentials
# stored in `platform_settings`. WITHOUT this, the /settings/api-keys
# UI will show "encryption disabled" and refuse to store new keys.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# ── Frontend (BUILD-TIME — see SETUP.md §Build images) ─────────
# These two values are inlined into the JavaScript bundle by Next.js
# during `docker build`. Setting them in the running pod has NO effect
# on what the browser sends. They MUST be passed as --build-arg when
# building the frontend image, and NEXT_PUBLIC_API_KEY MUST match
# API_KEY above.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_KEY=                       # = API_KEY (set at build time)

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=tiplatform
POSTGRES_USER=tiplatform
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_EXPOSE_PORT=0.0.0.0:5432

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_MAX_MEMORY=512mb
REDIS_EXPOSE_PORT=0.0.0.0:6379

# ── NATS ─────────────────────────────────────────────────────────
NATS_USER=tiplatform
NATS_PASSWORD=change-me-strong-nats-password
NATS_EXPOSE_PORT=0.0.0.0:4222

# ── Network / Ports ──────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
ICAP_EXPOSE_PORT=0.0.0.0:1344

# ── Threat Feed API Keys (optional) ──────────────────────────────
# These can also be set at runtime through the /settings/api-keys UI
# (which encrypts them at rest with MASTER_ENCRYPTION_KEY). The DB
# value, when present, takes precedence over the env value below.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
THREATFOX_API_KEY=
MALWAREBAZAAR_API_KEY=
VIRUSTOTAL_API_KEY=

# ── Feed Configuration ───────────────────────────────────────────
URLHAUS_ENABLED=true
THREATFOX_ENABLED=true
MALWAREBAZAAR_ENABLED=true
OPENPHISH_ENABLED=true
FEED_POLL_INTERVAL=3600

# ── Enrichment ───────────────────────────────────────────────────
ENRICHMENT_WORKERS=4
# MaxMind GeoLite2 license key (free registration at maxmind.com).
# Without it, the GeoIP module is skipped — enrichment still runs.
MAXMIND_LICENSE_KEY=

# Comma-separated list of trusted internal IPs / CIDRs that should
# never trigger "unknown source" alerts (firewalls, jump hosts, etc.)
KNOWN_DEVICE_IPS=

# ── Sandbox Integration ──────────────────────────────────────────
SANDBOX_ENABLED=false
SANDBOX_URL=http://your-sandbox-host:8000

# ── Alerting ─────────────────────────────────────────────────────
ALERT_MIN_CONFIDENCE=60

# ── Observability ────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password
GRAFANA_DOMAIN=localhost
PROMETHEUS_RETENTION=30d

# ── CORS (frontend origins allowed to call the API) ──────────────
CORS_ORIGINS=http://localhost:3000,https://your-domain.example.com
